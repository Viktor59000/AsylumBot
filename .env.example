# ---- AsylumBot — variables d'environnement ----
# Copier ce fichier en `.env` et remplir les valeurs. NE JAMAIS committer le vrai .env.

# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application (Client) ID du bot (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur Discord où enregistrer les commandes (mode dev = guild-only, maj instantanée)
# Clic droit sur le serveur > Copier l'identifiant du serveur (mode développeur activé)
GUILD_ID=

# Base de données PostgreSQL (obligatoire — le bot et le futur site partagent cette base).
# En local (ex. via Docker) : docker run -d --name asylum-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=asylumbot -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asylumbot"
# En production (Railway) : utiliser l'URL du plugin PostgreSQL managé, ex. :
# DATABASE_URL="postgresql://user:password@host:5432/asylum"
# Appliquer le schéma : npx prisma migrate deploy

# OPTIONNEL — ID du rôle "joueur" à ping au lancement d'un match Arena. Laisser vide si non utilisé.
PLAYER_ROLE_ID=

# OPTIONNEL — URL publique du site web (liens "profil web" dans les embeds Discord).
# Ex: http://localhost:3000 en dev, https://asylum.example.com en prod.
WEB_BASE_URL=

# OPTIONNEL — Clé API Riot (previews live joueurs, module TrackerManager).
# À créer sur https://developer.riotgames.com (les clés de dev expirent en 24h).
# Les liens trackers (op.gg, tracker.gg...) fonctionnent SANS clé.
RIOT_API_KEY=
