generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Discord ID
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coins     Int      @default(0)
  status    String   @default("IDLE") // IDLE, QUEUED, LOBBY, INGAME

  // Relations
  elo       Elo[]
  matches   MatchPlayer[]
  igns      UserIgn[]
  penalties Penalty[]
  daily     DailyProgress?
  purchases Purchase[]
  
  clanId    Int?
  clan      Clan?    @relation(fields: [clanId], references: [id])
}

model DailyProgress {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  matchesPlayed Int     @default(0)
  matchesWon    Int     @default(0)
  lastUpdate    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id])
}

model UserIgn {
  id         Int      @id @default(autoincrement())
  userId     String
  game       String
  ign        String
  preferences String? // JSON string for roles, agents, etc.
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, game])
}

model Elo {
  id            Int      @id @default(autoincrement())
  userId        String
  game          String   // 'rl', 'cs2', 'r6s', 'lol', 'valorant'
  mode          String   @default("soloq") // queue mode: 'soloq', '1v1', '2v2', '3v3', ...
  rating        Int      @default(1000)
  wins          Int      @default(0)
  losses        Int      @default(0)
  winStreak     Int      @default(0)
  highestRating Int      @default(1000)
  lastMatchDate DateTime @default(now())
  seasonId      Int?

  user          User     @relation(fields: [userId], references: [id])
  season        Season?  @relation(fields: [seasonId], references: [id])

  @@unique([userId, game, mode, seasonId], name: "userId_game_mode_seasonId")
}

model Match {
  id        Int      @id @default(autoincrement())
  game      String
  mode      String   @default("soloq") // queue mode this match was played in
  matchType String   @default("tvt") // 'tvt' (binary winner) or 'placement' (ranking 1→N)
  guildId   String?
  createdAt DateTime @default(now())
  winner    String?  // 'team1' or 'team2' (tvt) / first-placed team key (placement)
  map       String?
  isRanked  Boolean  @default(true)
  status    String   @default("pending") // pending, live, reported, cancelled, abandoned
  seasonId  Int?
  channelId1 String?
  channelId2 String?
  textChannelId   String?
  voiceChannelIds String? // JSON array of ALL voice channel ids (reliable cleanup after restart)

  players   MatchPlayer[]
  season    Season?  @relation(fields: [seasonId], references: [id])
}

model MatchPlayer {
  matchId   Int
  userId    String
  team      String   // 'team1'..'teamN'
  role      String?  // For LoL/Valorant
  kda       String?  // "K/D/A"
  placement Int?     // Final ranking of the player's team (placement matches: 1 = first)

  match     Match    @relation(fields: [matchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([matchId, userId])
}

model Season {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(false)
  
  elos      Elo[]
  matches   Match[]
}

model Map {
  id        Int      @id @default(autoincrement())
  game      String
  name      String
  imageUrl  String?
}

model Penalty {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String   // 'ban', 'mute', 'queue_ban'
  reason    String?
  duration  Int      // in minutes
  createdAt DateTime @default(now())
  expiresAt DateTime
  
  user      User     @relation(fields: [userId], references: [id])
}

model GuildConfig {
  id        String   @id // Guild ID
  bannerUrl String?
  logoUrl   String?
  themeColor String?
  language   String   @default("en")
}

model GameConfig {
  id        Int      @id @default(autoincrement())
  guildId   String
  game      String   // 'rl', 'lol', etc.
  region    String   // 'EUW', 'NA'
  mode      String   // queue mode: 'soloq', '1v1', '2v2', '3v3', ...

  // Channel IDs
  queueChannelId        String?
  historyChannelId      String?
  leaderboardChannelId  String?
  adminLogChannelId     String?
  webhookUrl            String?
  queueMessageId        String? // ID of the permanent queue message for auto-updates
  leaderboardMessageId  String? // ID of the permanent leaderboard message (edited in place)
  voiceGateEnabled      Boolean @default(false) // require being in voice to accept the ready-check

  @@unique([guildId, game, mode], name: "guildId_game_mode")
}

model ShopItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  roleId      String
  imageUrl    String?
  isActive    Boolean  @default(true)
  
  purchases   Purchase[]
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    String
  itemId    Int
  cost      Int
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  item      ShopItem @relation(fields: [itemId], references: [id])
}

model RoleMenuOption {
  id        Int      @id @default(autoincrement())
  guildId   String
  label     String
  emoji     String
  roleId    String
  
  @@unique([guildId, roleId])
}

// Generic key/value store for bot-level persistent state (last cron runs, etc.)
model BotState {
  key   String @id
  value String
}

model Clan {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  imageUrl    String?
  leaderId    String
  createdAt   DateTime @default(now())
  
  members     User[]
}
