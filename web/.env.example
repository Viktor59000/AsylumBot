# ---- AsylumBot Web — variables d'environnement ----
# Copier en `web/.env` et remplir. NE JAMAIS committer le vrai .env.

# Même base PostgreSQL que le bot (schéma Prisma partagé)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asylumbot"

# OAuth2 Discord (Developer Portal > ton application > OAuth2)
# Redirect URI à AJOUTER dans le portail : http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Générer avec: openssl rand -base64 32  (ou n'importe quelle chaîne longue aléatoire)
NEXTAUTH_SECRET=
