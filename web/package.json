{
  "name": "asylum-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:sync": "node -e \"require('fs').copyFileSync('../prisma/schema.prisma','prisma/schema.prisma')\"",
    "prisma:generate": "npm run prisma:sync && prisma generate",
    "dev": "npm run prisma:generate && next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "14.2.35",
    "next-auth": "^4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
